<?xml version="1.0"?>
<robot name="wheel_test">

  <link name="world_link"/>

  <joint name="wheel_joint" type="continuous">
    <parent link="world_link"/>
    <child link="base_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/> </joint>

  <link name="base_link">
    <inertial>
      <origin xyz="1.39722660524866E-10 -2.65159526280367E-11 0.00210901865278185" rpy="0 0 0" />
      <mass value="3.01582823547934" />
      <inertia ixx="0.00905891929875062" ixy="-5.345243561681E-13" ixz="-5.01059329249382E-13" iyy="0.00905891929867343" iyz="-3.09264747852774E-13" izz="0.00996337830126816" />
    </inertial>

    <visual>
      <origin xyz="0 0 0" rpy="1.5708 0 0" /> 
      <geometry>
        <mesh filename="package://mi_rover_description/meshes/Wheel/wheel.STL" />
      </geometry>
      <material name="gris">
        <color rgba="1 1 1 1"/>
      </material>
    </visual>

    <collision>
      <origin xyz="0 0 0" rpy="1.5708 0 0" />
      <geometry>
        <mesh filename="package://mi_rover_description/meshes/Wheel/wheel.STL" />
      </geometry>
    </collision>
  </link>

</robot>
